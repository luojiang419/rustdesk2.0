			<Component Guid="74f847ce-823b-44a4-82ea-04acce7488f9" Subdirectory="data\flutter_assets\assets">
				<File Source="G:/data/app/rustdesk/flutter/build/windows/x64/runner/Release/data/flutter_assets/assets/chat.svg" KeyPath="yes" Checksum="yes" />
			</Component>
			<Component Guid="25060eaa-0b61-481a-8a8a-66dfd6d4ee54" Subdirectory="data\flutter_assets\assets">
				<File Source="G:/data/app/rustdesk/flutter/build/windows/x64/runner/Release/data/flutter_assets/assets/chat2.svg" KeyPath="yes" Checksum="yes" />
			</Component>
			<Component Guid="365d085d-25a9-4810-82cc-80a769d00619" Subdirectory="data\flutter_assets\assets">
				<File Source="G:/data/app/rustdesk/flutter/build/windows/x64/runner/Release/data/flutter_assets/assets/checkbox-outline.svg" KeyPath="yes" Checksum="yes" />
			</Component>
			<Component Guid="607087aa-9e62-4cad-882d-06630c7ca2eb" Subdirectory="data\flutter_assets\assets">
				<File Source="G:/data/app/rustdesk/flutter/build/windows/x64/runner/Release/data/flutter_assets/assets/chevron_up_chevron_down.svg" KeyPath="yes" Checksum="yes" />
			</Component>
			<Component Guid="b614efc2-9a4f-4e14-a1d1-645e14ffa1c7" Subdirectory="data\flutter_assets\assets">
