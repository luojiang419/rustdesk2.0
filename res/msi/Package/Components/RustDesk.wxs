			</Component>
			<Component Guid="49e0bd88-82cb-42c9-8fa4-92d492871b94" Subdirectory="data\flutter_assets\assets">
				<File Source="G:/data/app/rustdesk/flutter/build/windows/x64/runner/Release/data/flutter_assets/assets/auth-okta.svg" KeyPath="yes" Checksum="yes" />
			</Component>
			<Component Guid="30bf6977-21c1-4e07-9e64-f59a385110e3" Subdirectory="data\flutter_assets\assets">
				<File Source="G:/data/app/rustdesk/flutter/build/windows/x64/runner/Release/data/flutter_assets/assets/call_end.svg" KeyPath="yes" Checksum="yes" />
			</Component>
			<Component Guid="53e34563-e241-48d4-8e5c-047e13c4012f" Subdirectory="data\flutter_assets\assets">
